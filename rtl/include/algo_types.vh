// ---------------------------------------------------------------------------
// algo_types.vh —— 定点位宽约定（单一来源）
// 电压量纲满量程约 0..1000 V 级；当前 scaffold 域为 U16（1 LSB = 量程/65535）。
// 后续 pv_* 模块引入 Q 格式时在此统一定义，禁止各模块自行约定。
// ---------------------------------------------------------------------------
`ifndef ALGO_TYPES_VH
`define ALGO_TYPES_VH

`define ALGO_W_VOLT            16      //电压相关量用16位
`define ALGO_W_DUTY            8       //占空比相关量用8位
`define ALGO_W_SAMPLE_CNT      32      //采样计数器用32位

`endif
